{
  "name": "mobile-home-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "db:init:local": "wrangler d1 migrations apply mobile-home --local",
    "db:init:remote": "wrangler d1 migrations apply mobile-home --remote",
    "benutzer:local": "node scripts/benutzer-anlegen.mjs --local",
    "benutzer:remote": "node scripts/benutzer-anlegen.mjs --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
